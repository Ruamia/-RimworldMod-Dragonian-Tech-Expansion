<?xml version="1.0" encoding="utf-8" ?>
<Patch>

    <!-- ========================================== -->
    <!-- 1. 斩龙尾 (基础版本) -->
    <!-- ========================================== -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="DRM_SlashTail"]</xpath>
        <value>
            <!-- 强制覆盖分类为仿生体，Inherit="False" 代表不继承父类的列表 -->
            <thingCategories Inherit="False">
                <li>BodyPartsProsthetic</li>
            </thingCategories>
            <costList>
                <Plasteel>25</Plasteel>
                <ComponentSpacer>4</ComponentSpacer>
            </costList>
            <recipeMaker>
                <recipeUsers>
                    <li>DragonianSmith</li>
                    <li>FueledSmithy</li>
                    <li>ElectricSmithy</li>
                </recipeUsers>
                <researchPrerequisites>
                    <li>DragonianSpecializedBionics</li>
                </researchPrerequisites>
                <skillRequirements>
                    <Crafting>8</Crafting>
                </skillRequirements>
            </recipeMaker>
        </value>
    </Operation>


