        <xpath>Defs/RecipeDef[recipeUsers/li[text()="ElectricSmithy"]]/recipeUsers</xpath>
        <value><li>DragonianSmith</li></value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/RecipeDef[recipeUsers/li[text()="FueledSmithy"]]/recipeUsers</xpath>
        <value><li>DragonianSmith</li></value>
    </Operation>
