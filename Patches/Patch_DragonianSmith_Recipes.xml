        <xpath>Defs/ThingDef[recipeMaker/recipeUsers/li[text()="ElectricTailoringBench"]]/recipeMaker/recipeUsers</xpath>
        <value><li>DragonianSmith</li></value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[recipeMaker/recipeUsers/li[text()="HandTailoringBench"]]/recipeMaker/recipeUsers</xpath>
        <value><li>DragonianSmith</li></value>
    </Operation>

</Patch>