        <description>使用龙珠、玻璃钢和高级零部件重铸一颗硬化龙珠。</description>
        <jobString>重铸硬化龙珠中。</jobString>
        <workAmount>30000</workAmount>
        <researchPrerequisite>DragonianOrbReforge</researchPrerequisite>
        <recipeUsers>
            <li>FueledSmithy</li>
            <li>ElectricSmithy</li>
        </recipeUsers>
        <ingredients>
            <li><filter><thingDefs><li>DragonianOrb</li></thingDefs></filter><count>1</count></li>
            <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>40</count></li>
            <li><filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter><count>3</count></li>
        </ingredients>
        <products>
            <HardenDragonianOrb>1</HardenDragonianOrb>
        </products>
    </RecipeDef>

