<Defs>
	<!-- ========================================================== -->
	<!-- ========== 基础抽象类 ========== -->
	<!-- ========================================================== -->
	<ThingDef Name="DTE_InsulatedNurseryBase" ParentName="BuildingBase" Abstract="True">
		<thingClass>Building_PlantGrower</thingClass>
		<category>Building</category>
		<designationCategory>Furniture</designationCategory>
		<staticSunShadowHeight>0.2</staticSunShadowHeight>
		<altitudeLayer>LowPlant</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>10</pathCost>
		<fillPercent>0.5</fillPercent>
		<rotatable>true</rotatable>
		<tickerType>Normal</tickerType> 
		<canOverlapZones>false</canOverlapZones>
		<castEdgeShadows>true</castEdgeShadows>
		<statBases>
			<WorkToBuild>1200</WorkToBuild>
			<Flammability>0</Flammability>
		</statBases>
		<building>
			<isSittable>false</isSittable>
			<defaultPlantToGrow>Plant_Rice</defaultPlantToGrow>
			<sowTag>Ground</sowTag> 
			<buildingTags>
				<li>PlantGrower</li>
			</buildingTags>
		</building>
	</ThingDef>
	
	<!-- ========================================================== -->
	<!-- ========== 1. 保温苗圃 (肥力 100%) ========== -->
	<!-- ========================================================== -->
	
	<ThingDef ParentName="DTE_InsulatedNurseryBase">
		<defName>DTE_Nursery</defName>
		<label>保温箱</label>
		<description>不需要电力的种植槽。在室内铺设能保护作物免受严寒侵袭。</description>
        <graphicData>
            <texPath>Things/Building/PlantGrower/Nursery</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
            <damageData>
                <enabled>false</enabled>
            </damageData>
			<drawSize>(1,1)</drawSize>
        </graphicData>
		<size>(1,1)</size>
		<rotatable>false</rotatable>
		<statBases>
			<MaxHitPoints>75</MaxHitPoints>
			<Fertility>1.0</Fertility>
		</statBases>
		<stuffCategories>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>50</costStuffCount>
		<costList>
			<Hay>10</Hay>
		</costList>
		<researchPrerequisites>
			<li>DragonianAgricultureTech</li>
		</researchPrerequisites>
		<comps>
			<li Class="CompProperties_HeatPusher">
				<compClass>CompHeatPusher</compClass>
				<heatPerSecond>1</heatPerSecond>
				<heatPushMaxTemperature>0</heatPushMaxTemperature>
			</li>
		</comps>
	</ThingDef>
	
	
