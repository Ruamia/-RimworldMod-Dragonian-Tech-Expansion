<?xml version='1.0' encoding='utf-8'?>
<Defs>
    <!-- ========================================== -->
    <!-- 1. 龙尾三轴稳定器 -->
    <!-- ========================================== -->
    <ThingDef ParentName="BodyPartBionicBase">
        <defName>DTE_TailStabilizer</defName>
        <label>三轴稳定器</label>
        <description>一种植入于脊椎与尾巴之间的微型三轴陀螺仪，它能读取尾部肌肉的微小摆动，实时修正植入者的站姿与持械手部偏移。与反射增强器和动力学优化器互斥。</description>
        <descriptionHyperlinks>
            <HediffDef>DTE_TailStabilizer</HediffDef>
        </descriptionHyperlinks>
        <techLevel>Spacer</techLevel>
        <costList><Plasteel>20</Plasteel><ComponentSpacer>3</ComponentSpacer></costList>
        <recipeMaker>
            <recipeUsers><li>DragonianSmith</li><li>FueledSmithy</li><li>ElectricSmithy</li></recipeUsers>
            <researchPrerequisites><li>DragonianSpecializedBionics</li></researchPrerequisites>
            <skillRequirements><Crafting>8</Crafting></skillRequirements>
        </recipeMaker>
    </ThingDef>
    <HediffDef ParentName="ImplantHediffBase">
        <defName>DTE_TailStabilizer</defName>
        <label>三轴稳定器</label>
        <description>一个已安装的三轴稳定器。它能读取尾部肌肉的微小摆动，实时修正植入者的站姿与持械手部偏移。</description>
        <descriptionHyperlinks>
            <ThingDef>DTE_TailStabilizer</ThingDef>
        </descriptionHyperlinks>
        <tags><li>TailEnhancer</li></tags>
        <spawnThingOnRemoved>DTE_TailStabilizer</spawnThingOnRemoved>
        <stages>
            <li>
                <statOffsets>
                    <ShootingAccuracyPawn>0.25</ShootingAccuracyPawn>
                    <AimingDelayFactor>-0.2</AimingDelayFactor>
                    <MoveSpeed>-0.02</MoveSpeed>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>
    <RecipeDef ParentName="SurgeryInstallImplantBase">
        <defName>Install_DTE_TailStabilizer</defName>
        <label>安装三轴稳定器</label>
        <jobString>正在安装三轴稳定器。</jobString>
        <recipeUsers Inherit="false"><li>Dragonian_Race</li></recipeUsers>
        <workAmount>3000</workAmount>
        <skillRequirements><Medicine>8</Medicine></skillRequirements>
        <appliedOnFixedBodyParts><li>Torso</li></appliedOnFixedBodyParts> <!-- 统一装在躯干 -->
        <addsHediff>DTE_TailStabilizer</addsHediff>
        <incompatibleWithHediffTags><li>TailEnhancer</li></incompatibleWithHediffTags>
        <ingredients><li><filter><thingDefs><li>DTE_TailStabilizer</li></thingDefs></filter><count>1</count></li></ingredients>
        <fixedIngredientFilter><thingDefs><li>DTE_TailStabilizer</li></thingDefs></fixedIngredientFilter>
    </RecipeDef>
    <RecipeDef ParentName="SurgeryRemoveImplantBase">
        <defName>Remove_DTE_TailStabilizer</defName>
        <label>移除三轴稳定器</label>
        <jobString>正在移除三轴稳定器。</jobString>
        <workAmount>3000</workAmount>
        <recipeUsers Inherit="false"><li>Dragonian_Race</li></recipeUsers>
        <removesHediff>DTE_TailStabilizer</removesHediff>
    </RecipeDef>

