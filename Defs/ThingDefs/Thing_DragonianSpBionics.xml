    <!-- 5. 力量限制器 -->
    <!-- ========================================== -->
    <ThingDef ParentName="BodyPartBionicBase">
        <defName>DTE_StrengthLimiter</defName>
        <label>力量限制器</label>
        <description>一套可以将植入者的力量压制住的拘束装置，但基本不会影响日常活动。由于被限制了最大力量，植入者终于可以进行更精密的操作了。</description>
        <descriptionHyperlinks>
            <HediffDef>DTE_StrengthLimiter</HediffDef>
        </descriptionHyperlinks>
        <techLevel>Spacer</techLevel>
        <costList><Plasteel>25</Plasteel><ComponentSpacer>4</ComponentSpacer></costList>
        <recipeMaker>
            <recipeUsers><li>DragonianSmith</li><li>FueledSmithy</li><li>ElectricSmithy</li></recipeUsers>
            <researchPrerequisites><li>DragonianSpecializedBionics</li></researchPrerequisites>
            <skillRequirements><Crafting>8</Crafting></skillRequirements>
        </recipeMaker>
    </ThingDef>
    <HediffDef ParentName="ImplantHediffBase">
        <defName>DTE_StrengthLimiter</defName>
        <label>力量限制器</label>
        <description>一个已安装的力量限制器。可以将植入者的力量压制住，但基本不会影响日常活动。由于被限制了最大力量，植入者终于可以进行更精密的操作了。</description>
        <descriptionHyperlinks>
			<ThingDef>DTE_StrengthLimiter</ThingDef>
        </descriptionHyperlinks>
        <spawnThingOnRemoved>DTE_StrengthLimiter</spawnThingOnRemoved>
        <stages>
            <li>
                <statFactors><MeleeDamageFactor>0.3</MeleeDamageFactor></statFactors>
                <statOffsets>
                    <MoveSpeed>-0.05</MoveSpeed>
                    <ShootingAccuracyPawn>0.25</ShootingAccuracyPawn>
                    <AimingDelayFactor>-0.2</AimingDelayFactor>
                    <MeleeCooldownFactor>-0.2</MeleeCooldownFactor>
                    <RangedCooldownFactor>-0.2</RangedCooldownFactor>
                    <SurgerySuccessChanceFactor>0.15</SurgerySuccessChanceFactor>
                    <MedicalTendQuality>0.15</MedicalTendQuality>
                    <MedicalTendSpeed>0.5</MedicalTendSpeed>
                </statOffsets>
                <capMods><li><capacity>Manipulation</capacity><offset>0.25</offset></li></capMods>
            </li>
        </stages>
    </HediffDef>
    <RecipeDef ParentName="SurgeryInstallImplantBase">
        <defName>Install_DTE_StrengthLimiter</defName>
        <label>安装力量限制器</label>
        <jobString>正在安装力量限制器。</jobString>
        <recipeUsers Inherit="false"><li>Dragonian_Race</li></recipeUsers>
        <workAmount>3000</workAmount>
        <skillRequirements><Medicine>8</Medicine></skillRequirements>
        <appliedOnFixedBodyParts><li>Torso</li></appliedOnFixedBodyParts>
        <addsHediff>DTE_StrengthLimiter</addsHediff>
        <ingredients><li><filter><thingDefs><li>DTE_StrengthLimiter</li></thingDefs></filter><count>1</count></li></ingredients>
        <fixedIngredientFilter><thingDefs><li>DTE_StrengthLimiter</li></thingDefs></fixedIngredientFilter>
    </RecipeDef>
    <RecipeDef ParentName="SurgeryRemoveImplantBase">
        <defName>Remove_DTE_StrengthLimiter</defName>
        <label>移除力量限制器</label>
        <jobString>正在移除力量限制器。</jobString>
        <workAmount>3000</workAmount>
        <recipeUsers Inherit="false"><li>Dragonian_Race</li></recipeUsers>
        <removesHediff>DTE_StrengthLimiter</removesHediff>
