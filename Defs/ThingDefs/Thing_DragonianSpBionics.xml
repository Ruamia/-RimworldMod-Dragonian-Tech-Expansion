    <!-- ========================================== -->
    <!-- 4. 龙珠护壳 -->
    <!-- ========================================== -->
    <ThingDef ParentName="BodyPartBionicBase">
        <defName>DTE_OrbShell</defName>
        <label>龙珠护壳</label>
        <description>将龙珠保护在一个外壳之中，这个壳可以稳定地吸收龙珠的再生能量并储存起来，并在植入者濒死时将其从死亡边缘拉回。由于手术风险很大，这个外壳在安装后无法被卸除。</description>
        <descriptionHyperlinks>
            <HediffDef>DTE_OrbShell</HediffDef>
        </descriptionHyperlinks>
        <techLevel>Spacer</techLevel>
        <costList><Plasteel>30</Plasteel><ComponentSpacer>5</ComponentSpacer></costList>
        <recipeMaker>
            <recipeUsers><li>DragonianSmith</li><li>FueledSmithy</li><li>ElectricSmithy</li></recipeUsers>
            <researchPrerequisites><li>DragonianSpecializedBionics</li></researchPrerequisites>
            <skillRequirements><Crafting>9</Crafting></skillRequirements>
        </recipeMaker>
    </ThingDef>
    <HediffDef ParentName="ImplantHediffBase">
        <defName>DTE_OrbShell</defName>
        <label>龙珠护壳</label>
        <description>一个已安装的龙珠护壳。这个壳可以稳定地吸收龙珠的再生能量并储存起来，并在植入者濒死时将其从死亡边缘拉回。无法卸除。</description>
        <descriptionHyperlinks>
			<ThingDef>DTE_OrbShell</ThingDef>
        </descriptionHyperlinks>
        <everCurableByItem>false</everCurableByItem>
        <spawnThingOnRemoved>DTE_OrbShell</spawnThingOnRemoved>
        <comps>
            <li Class="DragonianTechExpansion.HediffCompProperties_OrbShell">
                <cooldownTicks>3600000</cooldownTicks>
            </li>
        </comps>
        <stages>
            <li>
                <statFactors>
                    <InjuryHealingFactor>0.95</InjuryHealingFactor>
                </statFactors>
            </li>
        </stages>
    </HediffDef>
    <RecipeDef ParentName="SurgeryInstallImplantBase">
        <defName>Install_DTE_OrbShell</defName>
        <label>安装龙珠护壳</label>
        <jobString>正在安装龙珠护壳。</jobString>
        <recipeUsers Inherit="false"><li>Dragonian_Race</li></recipeUsers>
        <workAmount>4500</workAmount>
        <skillRequirements><Medicine>9</Medicine></skillRequirements>
        <appliedOnFixedBodyParts><li>Torso</li></appliedOnFixedBodyParts> <!-- 统一装在躯干 -->
        <addsHediff>DTE_OrbShell</addsHediff>
        <ingredients><li><filter><thingDefs><li>DTE_OrbShell</li></thingDefs></filter><count>1</count></li></ingredients>
        <fixedIngredientFilter><thingDefs><li>DTE_OrbShell</li></thingDefs></fixedIngredientFilter>
    </RecipeDef>

