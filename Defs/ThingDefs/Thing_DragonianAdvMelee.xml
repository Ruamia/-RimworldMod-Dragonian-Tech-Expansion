<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- ========================================================== -->
    <!-- ========== 龙娘先进近战武器 - 抽象基类 ========== -->
    <!-- ========================================================== -->
    <ThingDef Name="DTE_DragonianAdvancedMeleeBase" ParentName="BaseMeleeWeapon_Sharp_Quality" Abstract="True">
        <techLevel>Medieval</techLevel>
        <recipeMaker>
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <workSkill>Crafting</workSkill>
            <effectWorking>Smith</effectWorking>
            <soundWorking>Recipe_Smith</soundWorking>
            <researchPrerequisites>
                <li>DragonianAdvancedMelee</li>
            </researchPrerequisites>
            <recipeUsers Inherit="false">
                <li>DragonianSmith</li>
	            <li>FueledSmithy</li>
				<li>ElectricSmithy</li>
            </recipeUsers>
            <skillRequirements>
                <Crafting>10</Crafting>
            </skillRequirements>
        </recipeMaker>
        <thingCategories Inherit="false">
            <li>DRWeapons</li>
        </thingCategories>
        <tradeTags>
            <li>DR_WeaponAll</li>
        </tradeTags>
    </ThingDef>


    <!-- ========================================================== -->
    <!-- ========== 1. 恶龙指虎 ========== -->
    <!-- ========================================================== -->
    <ThingDef ParentName="DTE_DragonianAdvancedMeleeBase">
        <defName>DTE_DragonianClaw</defName>
        <label>龙娘 恶龙指虎</label>
        <description>一套重型指虎。最终的伤害取决于使用者的肉体能力，还能提高使用者的闪避能力与移动速度。</description>
        <graphicData>
            <texPath>Things/Weapon/DTE_Claw</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>0.5</drawSize>
        </graphicData>
        <uiIconScale>1.2</uiIconScale>
        <statBases>
            <WorkToMake>25000</WorkToMake>
            <Mass>4.5</Mass>
        </statBases>
        <equippedAngleOffset>-20</equippedAngleOffset>
        <costStuffCount>60</costStuffCount>
        <stuffCategories>
            <li>Metallic</li>
        </stuffCategories>
        <costList>
            <WoolDragonian>30</WoolDragonian>
            <DragonianScale>20</DragonianScale>
        </costList>
		<weaponTags>
			<li>DR_BattleMace</li>
		</weaponTags>
        <tools>
            <li>
                <label>claw</label>
                <capacities>
                    <li>Scratch</li>
                </capacities>
                <power>6</power>
                <cooldownTime>1.2</cooldownTime>
                <armorPenetration>0.35</armorPenetration>
                <chanceFactor>2</chanceFactor>
            </li>
            <li>
                <label>fist</label>
                <labelUsedInLogging>false</labelUsedInLogging>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>4</power>
                <cooldownTime>0.6</cooldownTime>
                <armorPenetration>0.1</armorPenetration>
                <chanceFactor>4</chanceFactor>
            </li>
        </tools>
        <equippedStatOffsets>
            <MeleeDodgeChance>0.25</MeleeDodgeChance>
            <MoveSpeed>0.50</MoveSpeed>
			<DR_DragonSculptureM>10</DR_DragonSculptureM>
            <DTE_RangedDodgeChance>0.8</DTE_RangedDodgeChance>
        </equippedStatOffsets>
        <!-- 被动效果：最终伤害会加上天生武器的数值 -->
        <comps>
            <li Class="DragonianTechExpansion.CompProperties_AddNaturalMeleePower">
                <multiplier>0.5</multiplier>
            </li>
        </comps>
    </ThingDef>

    <!-- ========================================================== -->
    <!-- ========== 2. 龙娘超大剑 ========== -->
    <!-- ========================================================== -->
    <ThingDef ParentName="DTE_DragonianAdvancedMeleeBase">
        <defName>DTE_DragonianUltraGreatsword</defName>
        <label>龙娘 双手大剑</label>
        <description>即使是龙娘也很难挥动的超重型大剑，但一旦将其挥舞起来将会是一场大屠杀。</description>
        <graphicData>
            <texPath>Things/Weapon/UltraGreatsword</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>3.5</drawSize>
        </graphicData>
        <uiIconScale>1.0</uiIconScale>
        <statBases>
            <WorkToMake>40000</WorkToMake>
            <Mass>22.0</Mass>
        </statBases>
        <equippedAngleOffset>50</equippedAngleOffset>
        <costStuffCount>120</costStuffCount>
        <stuffCategories>
            <li>Metallic</li>
        </stuffCategories>
        <costList>
            <WoolDragonian>50</WoolDragonian>
            <DragonianScale>30</DragonianScale>
        </costList>
		<weaponTags>
			<li>DR_Battlesword</li>
		</weaponTags>
        <tools>
            <li>
                <label>handle</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>15</power>
                <cooldownTime>2.5</cooldownTime>
				<chanceFactor>1</chanceFactor>
            </li>
            <li>
                <label>massive blade</label>
                <labelUsedInLogging>false</labelUsedInLogging>
                <capacities>
                    <li>Cut</li>
                    <li>Demolish</li>
                </capacities>
                <power>50</power>
                <cooldownTime>5</cooldownTime>
                <armorPenetration>0.20</armorPenetration>
				<chanceFactor>2</chanceFactor>
            </li>
        </tools>
        <equippedStatOffsets>
            <MoveSpeed>-0.30</MoveSpeed>
            <DR_DragonSculptureM>10</DR_DragonSculptureM>
        </equippedStatOffsets>
        <!-- 技能：回旋斩 (持续AOE，结束眩晕) -->
        <comps>
            <li Class="CompProperties_EquippableAbility">
                <abilityDef>DTE_WhirlwindSlash</abilityDef>
            </li>
        </comps>
    </ThingDef>
	
	<!-- 超大剑回旋斩技能 -->
	<AbilityDef>
		<defName>DTE_WhirlwindSlash</defName>
		<label>回旋斩</label>
		<description>挥舞超大剑进行持续数秒的旋风斩，对半径2内的所有目标造成伤害，期间可以移动。结束后会陷入短暂的眩晕。</description>
		<iconPath>UI/Abilities/Whirlwind</iconPath>
		<cooldownTicksRange>3600</cooldownTicksRange>
		<abilityClass>Ability</abilityClass>
		
		<!-- 关键修复 1：关闭目标要求，直接释放 -->
		<targetRequired>False</targetRequired>
		
		<!-- 关键修复 2：加入原版的施法动作，小人会做个原地起手的动作 -->
		<jobDef>CastAbilityOnThing</jobDef>
		<stunTargetWhileCasting>True</stunTargetWhileCasting>
	
		<verbProperties>
			<verbClass>Verb_CastAbility</verbClass>
			<warmupTime>0.5</warmupTime>
			<range>3</range> <!-- 攻击范围显示 -->
			<drawAimPie>False</drawAimPie>
			<requireLineOfSight>False</requireLineOfSight>
			<targetParams>
				<canTargetSelf>true</canTargetSelf>
				<canTargetLocations>false</canTargetLocations>
				<canTargetPawns>false</canTargetPawns>
				<canTargetBuildings>false</canTargetBuildings>
				<canTargetMechs>false</canTargetMechs>
				<canTargetAnimals>false</canTargetAnimals>
			</targetParams>
		</verbProperties>
		<comps>
		<li Class="CompProperties_AbilityEffect">
			<compClass>DragonianTechExpansion.CompAbilityEffect_Whirlwind</compClass>
		</li>
		</comps>
	</AbilityDef>
	
	<HediffDef>
		<defName>DTE_WhirlwindHediff</defName>
		<label>回旋斩</label>
		<description>强行挥舞超大剑进行持续数秒的旋风斩，对附近的所有目标造成伤害。。</description>
		<hediffClass>HediffWithComps</hediffClass>
		<comps>
		<li Class="HediffCompProperties_Disappears">
			<disappearsAfterTicks>180</disappearsAfterTicks> <!-- 持续 3 秒 (180 ticks) -->
		</li>
		<li Class="DragonianTechExpansion.HediffCompProperties_Whirlwind">
			<compClass>DragonianTechExpansion.HediffComp_Whirlwind</compClass>
			<radius>3.0</radius>
			<damageIntervalTicks>30</damageIntervalTicks> <!-- 每 0.5 秒判定一次伤害 -->
		</li>
		</comps>
		<stages>
		<li>
			<statFactors>
				<StaggerDurationFactor>0</StaggerDurationFactor>
			</statFactors>
			<becomeVisible>false</becomeVisible>
		</li>
		</stages>
	</HediffDef>
	
    <ThingDef ParentName="MoteBase">
        <defName>DTE_WhirlwindEffect</defName>
        <graphicData>
            <texPath>Effect/Whirlwind_Effect</texPath>
            <shaderType>MoteGlow</shaderType>
            <drawSize>6</drawSize>
        </graphicData>
        <altitudeLayer>MoteLow</altitudeLayer>
        <mote>
            <fadeInTime>0</fadeInTime>
            <solidTime>10</solidTime> <!-- 设个极大的值，我们靠代码掐断它 -->
            <fadeOutTime>0</fadeOutTime>
        </mote>
    </ThingDef>


