				<maxDistance>10</maxDistance>
				<customMote>Mote_CombatCommandLinkLine</customMote>
			</li>
		</comps>
	</HediffDef>
	
		<!-- 长笛 激活状态 -->
	<HediffDef>
		<defName>DTE_InstrumentAuraActive_Flute</defName>
		<label>笛声荡漾（激活）</label>
		<description>长笛声正在激发意志，使用者的移动和闪避受到限制。</description>
		<hediffClass>HediffWithComps</hediffClass>
		<isBad>false</isBad>
		<everCurableByItem>false</everCurableByItem>
		<stages>
			<li>
				<statOffsets>
					<MoveSpeed>-0.30</MoveSpeed>
					<MeleeDodgeChance>-0.20</MeleeDodgeChance>
				</statOffsets>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>9000</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
			<li Class="HediffCompProperties_GiveHediffsInRange">
				<range>9.9</range>
				<hediff>DTE_Aura_Flute_Inspire</hediff>
				<mote>Mote_CombatCommand</mote>
				<hideMoteWhenNotDrafted>true</hideMoteWhenNotDrafted>
				<targetingParameters>
					<canTargetBuildings>false</canTargetBuildings>
					<canTargetAnimals>false</canTargetAnimals>
					<canTargetMechs>false</canTargetMechs>
					<onlyTargetColonists>true</onlyTargetColonists>
				</targetingParameters>
			</li>
            <!-- 自定义的乐器演奏组件 -->
            <li Class="DragonianTechExpansion.HediffCompProperties_InstrumentPerformance">
                <radius>9.9</radius>
                <joyAmountPerSecond>0.1</joyAmountPerSecond>
                <!-- 使用你找到的音效 DefName -->
                <soundDefName>DTE_FlutePlay</soundDefName>
                <moteIntervalSeconds>0.5</moteIntervalSeconds>
            </li>
		</comps>
	</HediffDef>
	
	<!-- 长笛 增益状态 -->
	<HediffDef>
		<defName>DTE_Aura_Flute_Inspire</defName>
		<label>笛声荡漾</label>
		<description>长笛声激发着潜能，意识更加清晰，学习效率提升。</description>
		<hediffClass>HediffWithComps</hediffClass>
		<isBad>false</isBad>
		<stages>
			<li>
				<!-- 修复：意识属于能力(Capacity)，必须写在 capMods 里 -->
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<offset>0.2</offset>
					</li>
				</capMods>
				<!-- 学习效率属于属性(Stat)，依然写在 statOffsets 里 -->
				<statOffsets>
					<GlobalLearningFactor>0.5</GlobalLearningFactor>
				</statOffsets>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>600</disappearsAfterTicks>
				<showRemainingTime>false</showRemainingTime>
			</li>
			<li Class="HediffCompProperties_Link">
				<requireLinkOnOtherPawn>false</requireLinkOnOtherPawn>
				<maxDistance>10</maxDistance>
				<customMote>Mote_CombatCommandLinkLine</customMote>
			</li>
		</comps>
	</HediffDef>
	
