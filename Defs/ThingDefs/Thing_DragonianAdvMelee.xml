    <!-- 3.1 火炎铳枪 -->
    <ThingDef ParentName="DTE_DragonianAdvancedMeleeBase">
        <defName>DTE_Gunlance_Fire</defName>
        <label>龙娘 火炎铳枪</label>
        <description>装配了火炎击发装置的龙枪。龙娘可以驾驭它发动冲锋，并引发火焰爆炸。</description>
        <graphicData>
            <texPath>Things/Weapon/Gunlance_Fire</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>1.6</drawSize>
        </graphicData>
        <uiIconScale>1.1</uiIconScale>
		<researchPrerequisites>
            <li>DragonianAdvancedMelee</li>
			<li>DragonianEnhancedWeapon</li>
        </researchPrerequisites>
        <statBases>
            <WorkToMake>35000</WorkToMake>
            <Mass>14.0</Mass>
        </statBases>
        <equippedAngleOffset>45</equippedAngleOffset>
        <costStuffCount>80</costStuffCount>
        <stuffCategories>
            <li>Metallic</li>
        </stuffCategories>
        <costList>
            <WoolDragonian>40</WoolDragonian>
            <DragonianScale>20</DragonianScale>
            <ComponentIndustrial>5</ComponentIndustrial>
        </costList>
		<weaponTags>
			<li>DR_Gunlance</li>
			<li>DR_Battlesword</li>
		</weaponTags>
        <tools>
            <li>
                <label>spearhead</label>
                <capacities>
                    <li>Stab</li>
                </capacities>
                <power>20</power>
                <cooldownTime>3.0</cooldownTime>
                <armorPenetration>0.30</armorPenetration>
				<chanceFactor>2</chanceFactor>
                <extraMeleeDamages>
                    <li>
                        <def>DRM_Flame</def>
                        <amount>5</amount>
                    </li>
                </extraMeleeDamages>
            </li>
        </tools>
        <equippedStatOffsets>
            <MoveSpeed>-0.10</MoveSpeed>
            <DR_DragonSculptureM>10</DR_DragonSculptureM>
        </equippedStatOffsets>
        <comps>
            <!-- 使用自定义的多技能挂载组件 -->
            <li Class="DragonianTechExpansion.CompProperties_EquippableAbilities">
                <abilities>
                    <li>DTE_GunlanceCharge_Fire</li>
                    <li>DTE_GunlanceBreath_Fire</li>
                </abilities>
            </li>
        </comps>
        <meleeHitSound>DRHammerSound</meleeHitSound>
    </ThingDef>

