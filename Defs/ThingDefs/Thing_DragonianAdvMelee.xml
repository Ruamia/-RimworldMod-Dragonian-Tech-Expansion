		<comps>
			<li Class="DragonianTechExpansion.CompProperties_AbilityGunlanceCharge">
				<compClass>DragonianTechExpansion.CompAbilityEffect_GunlanceCharge</compClass>
				<damageDef>DRM_Flame</damageDef>
				<pathWidth>1.5</pathWidth>
				<damageMultiplier>1</damageMultiplier>
				<elementDef>DTE_GunlanceCharging_Fire</elementDef>
			</li>
		</comps>
	</AbilityDef>
	
