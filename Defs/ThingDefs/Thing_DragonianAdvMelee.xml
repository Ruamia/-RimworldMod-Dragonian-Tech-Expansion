    <JobDef>
        <defName>DTE_GunlanceChargeJob</defName>
        <driverClass>DragonianTechExpansion.JobDriver_GunlanceCharge</driverClass>
        <reportString>正在冲锋。</reportString>
        <casualInterruptible>false</casualInterruptible>
    </JobDef>
	
	<HediffDef>
		<defName>DTE_GunlanceCharging_Fire</defName>
		<label>冲锋</label>
		<description>正在冲锋！</description>
		<hediffClass>HediffWithComps</hediffClass>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>120</disappearsAfterTicks>
			</li>
			<li Class="DragonianTechExpansion.HediffCompProperties_GunlanceCharge">
				<compClass>DragonianTechExpansion.HediffComp_GunlanceCharge</compClass>
			</li>
		</comps>
		<stages>
		<li>
			<becomeVisible>false</becomeVisible>
		</li>
		</stages>
	</HediffDef>
	
	<HediffDef>
		<defName>DTE_GunlanceBreathSpread</defName>
		<label>龙息扩散</label>
		<description>龙息正在向前方蔓延。</description>
		<hediffClass>HediffWithComps</hediffClass>
		<isBad>false</isBad>
		<comps>
			<li Class="DragonianTechExpansion.HediffCompProperties_GunlanceBreathSpread">
				<compClass>DragonianTechExpansion.HediffComp_GunlanceBreathSpread</compClass>
			</li>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>120</disappearsAfterTicks>
			</li>
		</comps>
		<stages>
			<li>
				<label>扩散中</label>
				<becomeVisible>false</becomeVisible>
			</li>
		</stages>
	</HediffDef>
	
	<!-- 火炎冲锋 -->
	<AbilityDef>
		<defName>DTE_GunlanceCharge_Fire</defName>
		<label>火炎冲锋</label>
		<description>短暂蓄力后向目标发起冲刺，对路径上的敌人造成火焰伤害。</description>
		<iconPath>UI/Abilities/GunlanceCharge</iconPath>
		<cooldownTicksRange>6000</cooldownTicksRange>
		<cooldownPerCharge>true</cooldownPerCharge>
		<charges>2</charges>
		<jobDef>DTE_GunlanceChargeJob</jobDef>
		<verbProperties>
			<verbClass>Verb_CastAbility</verbClass>
