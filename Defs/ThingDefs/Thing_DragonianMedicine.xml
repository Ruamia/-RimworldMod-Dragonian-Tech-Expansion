    <!-- 催情素诱惑技能 -->
    <AbilityDef>
        <defName>DTE_AphrodisiacCharm</defName>
        <label>催情诱惑</label>
        <description>利用催情剂引发的荷尔蒙场，对目标释放强烈的心理暗示，使其在接下来的几天内深深地迷恋上施法者。</description>
        <iconPath>UI/Abilities/WordOfLove</iconPath> <!-- 可以直接用原版的图标 -->
        <cooldownTicksRange>0</cooldownTicksRange> <!-- 药物技能不需要冷却 -->
        <hostile>false</hostile>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        
        <!-- 使用近战施法动作 -->
        <jobDef>CastAbilityOnThingMelee</jobDef>
        
        <verbProperties>
            <verbClass>Verb_CastAbilityTouch</verbClass>
