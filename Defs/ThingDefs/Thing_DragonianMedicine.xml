        <descriptionHyperlinks>
            <HediffDef>DragonianAphrodisiacHigh</HediffDef>
            <HediffDef>DragonianAphrodisiacAddiction</HediffDef>
        </descriptionHyperlinks>
        <graphicData>
            <texPath>Things/Item/Resource/DragonianAphrodisiac</texPath>
