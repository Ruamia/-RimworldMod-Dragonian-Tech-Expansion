    <!-- ========== 龙娘法典 ========== -->
    <ThingDef ParentName="DTE_DragonianToolMeleeBase">
        <defName>DTE_DragonianCodex</defName>
        <label>龙娘 法典</label>
        <description>一本厚重的皮革封面法典，由于龙娘普遍不聪明，里面记满了重复的琐碎条款，挥动时颇具分量。</description>
