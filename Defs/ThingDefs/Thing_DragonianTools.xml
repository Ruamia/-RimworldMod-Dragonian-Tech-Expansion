            <texPath>Things/Tool/Codex</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
			<drawSize>0.6</drawSize>
        </graphicData>
        <uiIconScale>1</uiIconScale>
        <statBases>
            <WorkToMake>6000</WorkToMake>
            <Mass>2.5</Mass>
        </statBases>
        <costList>
            <WoodLog>20</WoodLog>
        </costList>
        <costStuffCount>30</costStuffCount>
        <stuffCategories>
            <li>Leathery</li>
        </stuffCategories>
        <equippedStatOffsets>
            <SocialImpact>0.30</SocialImpact>
            <TradePriceImprovement>0.08</TradePriceImprovement>
			<DR_DragonSculptureM>10</DR_DragonSculptureM>
        </equippedStatOffsets>
        <tools>
            <li>
                <label>spine</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>8</power>
                <cooldownTime>1.8</cooldownTime>
				<chanceFactor>5</chanceFactor>
